{
  "name": "envmanifest-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The config contract layer for AI-assisted software delivery.",
  "license": "MIT",
  "author": "GhostLogic Tech Company",
  "homepage": "https://github.com/adam-scott-thomas/envmanifest",
  "repository": {
    "type": "git",
    "url": "https://github.com/adam-scott-thomas/envmanifest.git"
  },
  "workspaces": [
    "packages/*",
    "actions/*",
    "site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
