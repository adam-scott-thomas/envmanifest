{
  "name": "@envmanifest/mcp-local",
  "version": "0.1.0",
  "description": "Local MCP server exposing envmanifest contracts to coding agents. Names + metadata only, never values.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "envmanifest-mcp": "./bin/server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@envmanifest/schema": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.4.1",
    "zod": "^3.23.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
