{
  "name": "@envmanifest/schema",
  "version": "0.1.1",
  "description": "JSON Schema and TypeScript types for the envmanifest contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://env.ghostlogic.tech",
  "bugs": {
    "url": "https://github.com/adam-scott-thomas/envmanifest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-scott-thomas/envmanifest.git",
    "directory": "packages/schema"
  },
  "keywords": [
    "envmanifest",
    "env",
    "config",
    "json-schema",
    "manifest"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.schema.v0.json": "./manifest.schema.v0.json"
  },
  "files": [
    "dist",
    "manifest.schema.v0.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "vitest": "^1.4.0",
    "yaml": "^2.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
