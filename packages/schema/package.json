{
  "name": "@envmanifest/schema",
  "version": "0.0.0",
  "description": "JSON Schema and TypeScript types for the envmanifest contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.schema.v0.json": "./manifest.schema.v0.json"
  },
  "files": [
    "dist",
    "manifest.schema.v0.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "vitest": "^1.4.0",
    "yaml": "^2.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
