{
  "name": "@envmanifest/schema",
  "version": "0.0.0",
  "description": "JSON Schema and TypeScript types for the envmanifest contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.schema.v0.json": "./manifest.schema.v0.json"
  },
  "files": [
    "dist",
    "manifest.schema.v0.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
